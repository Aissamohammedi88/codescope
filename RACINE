function detectLang(code) {
const head = code.substring(0, 4000).toLowerCase();
let best = 'text', bestScore = 0;
for (const key in LANGUAGES) {
const info = LANGUAGES[key];
let s = 0;
for (let i = 0; i < info.kws.length; i++) {
if (head.indexOf(info.kws[i].toLowerCase()) >= 0) s += info.w;
}
if (s > bestScore) { bestScore = s; best = key; }
}
return bestScore >= 2 ? best : 'text';
}

