def verify_python(code):
"""Vérification Python RÉELLE via ast."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}

try:
tree = ast.parse(code)
except SyntaxError as e:
errors.append({
"line": e.lineno or 0,
"col": e.offset or 0,
"message": e.msg or "Erreur de syntaxe",
"severity": "error",
})
return {"errors": errors, "status": "errors"}

# Imports non utilisés
class Visitor(ast.NodeVisitor):
def __init__(self):
self.imports = []
self.used_names = set()

def visit_Import(self, node):
for alias in node.names:
self.imports.append((alias.name, node.lineno))

def visit_ImportFrom(self, node):
for alias in node.names:
self.imports.append((alias.name, node.lineno))

def visit_Name(self, node):
self.used_names.add(node.id)

v = Visitor()
try:
v.visit(tree)
except Exception:
pass

for name, lineno in v.imports:
root = name.split(".")[0]
if root not in v.used_names:
errors.append({
"line": lineno,
"col": 0,
"message": "Import '" + name + "' non utilisé (avertissement)",
"severity": "warning",
})

status = "valid" if not errors else "warnings"
return {"errors": errors, "status": status}


def verify_json(code):
"""Vérification JSON RÉELLE."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}
try:
json.loads(code)
return {"errors": [], "status": "valid"}
except json.JSONDecodeError as e:
errors.append({
"line": e.lineno,
"col": e.colno,
"message": e.msg,
"severity": "error",
})
return {"errors": errors, "status": "errors"}


def verify_yaml(code):
"""Vérification YAML basique (sans dépendance)."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}

lines = code.split("\n")
for i, line in enumerate(lines, 1):
if line.startswith("\t"):
errors.append({
"line": i,
"col": 1,
"message": "Tabulation interdite en YAML (utiliser espaces)",
"severity": "error",
})

cur_indent = len(line) - len(line.lstrip(" "))
if line.strip() and not line.strip().startswith("#") and cur_indent % 2 != 0:
errors.append({
"line": i,
"col": cur_indent + 1,
"message": "Indentation impaire (" + str(cur_indent) + ") — YAML préfère les multiples de 2",
"severity": "warning",
})

status = "valid" if not errors else "warnings"
return {"errors": errors, "status": status}


def verify_html(code):
"""Vérification HTML basique (balises équilibrées)."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}

tags = re.findall(r"<(/?)([a-zA-Z][a-zA-Z0-9]*)[^>]*?(/?)>", code)
stack = []
void_tags = {"area", "base", "br", "col", "embed", "hr", "img",
"input", "link", "meta", "param", "source", "track", "wbr"}

line_no = 1
for closing, tag, self_close in tags:
tag = tag.lower()
# Calculer la ligne
pos = code.find("<" + tag)
if pos > 0:
line_no = code[:pos].count("\n") + 1

if tag in void_tags or self_close:
continue
if closing:
if stack and stack[-1][0] == tag:
stack.pop()
else:
errors.append({
"line": line_no,
"col": 0,
"message": "Balise fermante </" + tag + "> sans ouvrante",
"severity": "warning",
})
else:
stack.append((tag, line_no))

for tag, line in stack:
errors.append({
"line": line,
"col": 0,
"message": "Balise <" + tag + "> jamais fermée",
"severity": "error",
})

return {"errors": errors, "status": "errors" if errors else "valid"}


def verify_css(code):
"""Vérification CSS basique."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}

open_braces = code.count("{")
close_braces = code.count("}")
if open_braces != close_braces:
errors.append({
"line": 0,
"col": 0,
"message": "Accolades non équilibrées : " + str(open_braces) + " vs " + str(close_braces),
"severity": "error",
})

return {"errors": errors, "status": "errors" if errors else "valid"}


def verify_sql(code):
"""Vérification SQL basique."""
errors = []
if not code.strip():
return {"errors": [], "status": "empty"}

if code.count("(") != code.count(")"):
errors.append({
"line": 0,
"col": 0,
"message": "Parenthèses non équilibrées : " + str(code.count("(")) + " vs " + str(code.count(")")),
"severity": "error",
})

lines = [l for l in code.split("\n") if l.strip() and not l.strip().startswith("--")]
if lines:
last = lines[-1].strip()
if not last.endswith(";") and any(kw in code.upper() for kw in ["SELECT", "CREATE", "INSERT", "UPDATE", "DELETE"]):
errors.append({
"line": len(code.split("\n")),
"col": len(last),
"message": "Dernière requête SQL sans point-virgule final",
"severity": "warning",
})

return {"errors": errors, "status": "errors" if any(e["severity"] == "error" for e in errors) else "valid"}


def verify_code(code, lang):
"""Dispatche vers le bon vérificateur."""
verifiers = {
"python": verify_python,
"json": verify_json,
"yaml": verify_yaml,
"html": verify_html,
"css": verify_css,
"sql": verify_sql,
}
if lang in verifiers:
return verifiers[lang](code)

return {
"errors": [],
"status": "not-available",
"message": "Vérificateur non disponible pour " + lang + " (coloration uniquement)",
}


