function setLang(lang) {
state.lang = lang;
badge.textContent = (LANGUAGES[lang] && LANGUAGES[lang].name) || 'Texte';
}

// ═══════════════════════════════════════════════════════════════════
// VÉRIFICATION
// ═══════════════════════════════════════════════════════════════════
async function verifyCode() {
const code = editor.value;
const detected = detectLang(code);
if (detected !== 'text' && detected !== state.lang) setLang(detected);

const lines = code.split('\n').length;
const bytes = new Blob([code]).size;
statsEl.textContent = lines + ' ligne' + (lines > 1 ? 's' : '') +
' · ' + bytes + ' octet' + (bytes > 1 ? 's' : '');

try {
const resp = await fetch('/api/verify', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({ code: code, lang: state.lang })
});
const result = await resp.json();

clearConsole();

if (result.status === 'valid') {
log('✅ Syntaxe ' + ((LANGUAGES[state.lang] && LANGUAGES[state.lang].name) || state.lang) + ' valide', 'ok');
statusEl.textContent = '✓ OK';
statusEl.className = 'status';
} else if (result.status === 'not-available') {
log('ℹ️ ' + result.message, 'info');
log(' Langages supportés : ' + SUPPORTED.join(', '), 'info');
statusEl.textContent = 'Coloration seulement';
statusEl.className = 'info';
} else if (result.status === 'empty') {
log('⚠️ Aucun code à vérifier', 'warn');
statusEl.textContent = 'Vide';
statusEl.className = 'info';
} else {
let errCount = 0, warnCount = 0;
const errors = result.errors || [];
for (let i = 0; i < errors.length; i++) {
const err = errors[i];
const sev = err.severity || 'error';
if (sev === 'error') errCount++;
if (sev === 'warning') warnCount++;
const icon = sev === 'warning' ? '⚠️' : '❌';
log(icon + ' Ligne ' + err.line + ', col ' + err.col + ' : ' + err.message,
sev === 'warning' ? 'warn' : 'err');
}
log('Total : ' + errCount + ' erreur(s), ' + warnCount + ' avertissement(s)', 'warn');
statusEl.textContent = errCount + ' erreur(s)';
statusEl.className = 'err';
}

infoEl.textContent = (LANGUAGES[state.lang] && LANGUAGES[state.lang].name) || state.lang;
} catch (e) {
log('❌ Erreur API : ' + e.message, 'err');
}
}

function scheduleVerify() {
if (state.timer) clearTimeout(state.timer);
state.timer = setTimeout(verifyCode, 800);
}

// ═══════════════════════════════════════════════════════════════════
// ÉVÉNEMENTS
// ═══════════════════════════════════════════════════════════════════
editor.addEventListener('input', () => {
updateLineNumbers();
scheduleVerify();
});

editor.addEventListener('keydown', (e) => {
if (e.key === 'Tab') {
e.preventDefault();
const start = editor.selectionStart;
const end = editor.selectionEnd;
editor.value = editor.value.substring(0, start) + ' ' + editor.value.substring(end);
editor.selectionStart = editor.selectionEnd = start + 2;
updateLineNumbers();
scheduleVerify();
}
if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
e.preventDefault();
verifyCode();
}
});

document.getElementById('btn-verify').addEventListener('click', verifyCode);

document.getElementById('btn-clear').addEventListener('click', () => {
editor.value = '';
updateLineNumbers();
clearConsole();
log('Éditeur vidé', 'info');
});

document.getElementById('btn-save').addEventListener('click', () => {
const code = editor.value;
const info = LANGUAGES[state.lang] || {};
const ext = (info.ext && info.ext[0]) || '.txt';
const blob = new Blob([code], {type: 'text/plain'});
const url = URL.createObjectURL(blob);
const a = document.createElement('a');
a.href = url;
a.download = 'codescope-' + Date.now() + ext;
a.click();
URL.revokeObjectURL(url);
log('Fichier téléchargé : ' + a.download, 'ok');
});

document.getElementById('btn-open').addEventListener('click', () => {
document.getElementById('file-input').click();
});

document.getElementById('file-input').addEventListener('change', (e) => {
const file = e.target.files[0];
if (!file) return;
const reader = new FileReader();
reader.onload = (ev) => {
editor.value = ev.target.result;
updateLineNumbers();
setLang(detectLang(ev.target.result));
verifyCode();
log('Fichier ouvert : ' + file.name, 'info');
};
reader.readAsText(file);
});

document.getElementById('btn-lang').addEventListener('click', () => {
document.getElementById('modal-lang').classList.add('on');
});

// Grille langages
const grid = document.getElementById('lang-grid');
let html = '';
for (const key in LANGUAGES) {
const info = LANGUAGES[key];
const sup = SUPPORTED.indexOf(key) >= 0 ? ' ✅' : '';
html += '<div class="lang-item' + (key === state.lang ? ' active' : '') +
'" data-lang="' + key + '">' + info.name + sup + '</div>';
}
html += '<div class="lang-item" data-lang="text">Texte brut</div>';
grid.innerHTML = html;

const items = grid.querySelectorAll('.lang-item');
for (let i = 0; i < items.length; i++) {
items[i].addEventListener('click', function() {
setLang(this.dataset.lang);
for (let j = 0; j < items.length; j++) items[j].classList.remove('active');
this.classList.add('active');
document.getElementById('modal-lang').classList.remove('on');
verifyCode();
});
}

// Drag & drop
document.addEventListener('dragover', (e) => {
e.preventDefault();
document.body.classList.add('dragover');
});
document.addEventListener('dragleave', (e) => {
if (e.relatedTarget === null) document.body.classList.remove('dragover');
});
document.addEventListener('drop', (e) => {
e.preventDefault();
document.body.classList.remove('dragover');
const file = e.dataTransfer.files[0];
if (!file) return;
const reader = new FileReader();
reader.onload = (ev) => {
editor.value = ev.target.result;
updateLineNumbers();
setLang(detectLang(ev.target.result));
verifyCode();
log('Fichier déposé : ' + file.name, 'info');
};
reader.readAsText(file);
});

// Init
setLang('python');
updateLineNumbers();
log('CodeScope v' + '__VERSION__' + ' prêt.', 'ok');
log('Vérificateurs : ' + SUPPORTED.join(', '), 'info');
verifyCode();
</script>
</body>
</html>
"""


# ═══════════════════════════════════════════════════════════════════════════
# SERVEUR HTTP
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
server_version = "CodeScope/" + VERSION

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-store")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
path = self.path.split("?")[0]

if path in ("/", "/index.html"):
html = HTML_PAGE.replace("LANG_JSON", json.dumps(LANGUAGES, ensure_ascii=False))
html = html.replace("SUPPORTED_JSON", json.dumps(SUPPORTED_VERIFIERS, ensure_ascii=False))
html = html.replace("__VERSION__", VERSION)
return self._send(200, html)

if path == "/ping":
return self._json(200, {"pong": True, "ts": time.time()})

if path == "/status":
return self._json(200, {
"ok": True,
"service": "CodeScope",
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"languages": len(LANGUAGES),
"verifiers": SUPPORTED_VERIFIERS,
})

if path == "/languages":
return self._json(200, {"languages": LANGUAGES})

return self._send(404, "404 — Not found")

def do_POST(self):
path = self.path.split("?")[0]

try:
length = int(self.headers.get("Content-Length", "0") or "0")
body = self.rfile.read(length).decode("utf-8", "ignore") if length else "{}"
payload = json.loads(body)
except Exception:
payload = {}

if path == "/api/verify":
code = payload.get("code", "")
lang = payload.get("lang", "text")
detected = detect_language(code)
final_lang = detected if detected != "text" else lang
result = verify_code(code, final_lang)
result["lang"] = final_lang
return self._json(200, result)

if path == "/api/detect":
code = payload.get("code", "")
filename = payload.get("filename", "")
return self._json(200, {"lang": detect_language(code, filename)})

return self._json(404, {"error": "not found"})


class ThreadedServer(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════

def port_libre(port):
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
s.settimeout(0.5)
s.bind(("127.0.0.1", port))
return True
except OSError:
return False
finally:
try:
s.close()
except Exception:
pass


def ip_lan():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "127.0.0.1"


def main():
parser = argparse.ArgumentParser(description="CodeScope — Éditeur local")
parser.add_argument("--port", type=int, default=DEFAULT_PORT,
help="Port (défaut: " + str(DEFAULT_PORT) + ")")
parser.add_argument("--host", default="0.0.0.0",
help="Host (défaut: 0.0.0.0)")
args = parser.parse_args()

port = args.port
if not port_libre(port):
for p in range(port + 1, port + 20):
if port_libre(p):
port = p
break
else:
print("❌ Aucun port libre entre " + str(args.port) + " et " + str(args.port + 20))
sys.exit(1)

print()
print("=" * 74)
print(" ⚡ CodeScope v" + VERSION)
print(" Auteur : " + AUTEUR + " | Licence : " + LICENCE)
print("=" * 74)
print()
print(" 🌐 Local : http://localhost:" + str(port) + "/")
print(" 🌐 Réseau : http://" + ip_lan() + ":" + str(port) + "/")
print()
print(" 📱 a-Shell : ouvre l'URL ci-dessus dans Safari")
print()
print(" 📡 API :")
print(" GET /ping")
print(" GET /status")
print(" GET /languages")
print(" POST /api/verify")
print(" POST /api/detect")
print()
print(" 🧪 Vérificateurs : " + ", ".join(SUPPORTED_VERIFIERS))
print(" 🌐 Langages détectables : " + str(len(LANGUAGES)))
print()
print(" Ctrl+C pour arrêter")
print()

try:
server = ThreadedServer((args.host, port), Handler)
server.serve_forever()
except KeyboardInterrupt:
print()
print(" Arrêté.")
print()
except OSError as e:
print("❌ Erreur port " + str(port) + " : " + str(e))
sys.exit(1)


if __name__ == "__main__":
main()
