def detect_language(code, filename=""):
"""Détecte le langage par extension puis par contenu."""
if filename:
ext = os.path.splitext(filename)[1].lower()
for key, info in LANGUAGES.items():
if ext in info["ext"]:
return key

head = code[:4000].lower()
scores = {}
for key, info in LANGUAGES.items():
s = sum(info["w"] for kw in info["kws"] if kw.lower() in head)
if s > 0:
scores[key] = s

if not scores:
return "text"
best = max(scores.items(), key=lambda x: x[1])
return best[0] if best[1] >= 2 else "text"


